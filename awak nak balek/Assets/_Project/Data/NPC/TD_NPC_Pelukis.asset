%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b32718a15d73894478b662a8803d4725, type: 3}
  m_Name: TD_NPC_Pelukis
  m_EditorClassIdentifier: 
  npcName: Artist (Elise)
  maxTurns: 4
  targetResonance: 8
  clueChance: 0.75
  moodPool:
  - mood: 0
    min: 3
    max: 3
  - mood: 1
    min: 2
    max: 2
  - mood: 2
    min: 0
    max: 0
  - mood: 3
    min: -2
    max: -2
  requiredItems:
  - {fileID: 11400000, guid: c544d895c91904245884e8a3f9b28aa6, type: 2}
  lockedDialogue: Kecuali kau membawa pelarut cat atau alat pembersih yang kuminta
    dari bar, enyah sana!
  rewardItems:
  - {fileID: 11400000, guid: 33f817e052510894f9c16dae128740fc, type: 2}
  introDescription: 'Di dekat sudut galeri yang bermandikan cahaya lampu sorot hangat,
    sang pelukis berdiri di depan kanvas raksasa dengan tangan belepotan cat minyak.
    Napasnya memburu, matanya menyala oleh ambisi liar, frustrasi karena detail karya
    agungnya terancam rusak sebelum pameran tengah malam dimulai. '
  introDialogue: "\u201CAh! Itu dia! Pelarut dan bahan itu... Kau benar-benar menyelamatkan
    mahakaryaku dari kehancuran total! Baiklah, karena kau telah berjasa bagi masa
    depan seni modern, apa yang kau butuhkan?"
  winDialogue: "Kau adalah penyelamat sejati! Ambillah surat arahan resmi penugasan
    studionu ini\u2014katakan pada si penjaga pintu bahwa kau pergi atas mandat langsung
    dariku untuk misi seni yang sangat penting!"
  loseDialogue: Pergi! Konsentrasiku hancur lebur karena kehadiranmu! Kau sama sekali
    tidak punya jiwa seni!
  noClueText: " Ia lanjut fokus dan memikirkan karya seni yang ia buat\r"
  hints:
  - approach: 0
    likeLines:
    - With you here, her brushstrokes got more...showy
    rejectLines:
    - Her brushstrokes are getting weaker having eyes looking at her
  - approach: 1
    likeLines:
    - She asks you if your familiar with the inspiration for her art style
    rejectLines:
    - She told her frustation to you about people here talking about art like they
      can even paint
  - approach: 2
    likeLines:
    - She hand you a small canvas to have you do something too
    rejectLines:
    - She darted her eyes on her painting, and ask you to not touch it
  - approach: 3
    likeLines:
    - She is visibly thinking and shot down any attempts of talking for you
    rejectLines:
    - She struggle to focus without talking with a single soul
  approachReactions:
  - approach: 0
    veryLikeLines:
    - "Kuas dicengkam erat-erat, mata berbinar bisa terlihat dari sang pelukis\u201D  
      \u201CKau melihat komposisi lukisan ini sampai akar akarnya!? Impresif!"
    likeLines:
    - Kau melihat retakan pigmen merah itu, kan? Akhirnya ada yang punya mata jeli
      di ruangan ini.
    neutralLines:
    - Kau melihat, namun belum sampai jiwanya
    rejectLines:
    - Jangan tatap lukisanku setengah jadi seperti itu! Belum saatnya dinikmati publik!
  - approach: 1
    veryLikeLines:
    - Betul! Wawasan estetika luas seperti itu dapat membawa lukisan ini ke zaman
      selanjutnya!
    likeLines:
    - Luar biasa! Kau paham betul filosofi kontemporer di balik sapuan warna gelap
      ini!
    neutralLines:
    - Referensi mu standar, namun lanjutkan
    rejectLines:
    - Teori murahan dari orang awam! Jangan ajari aku soal komposisi visual!
  - approach: 2
    veryLikeLines:
    - Momentum dan kecepatan mu menyelamatkan karya ini!
    likeLines:
    - Gerakan refleks yang luar biasa sigap! Bagus, pegang sisi itu sebentar!
    neutralLines:
    - Kamu cepat, tapi hati-hati, kamu berada di antara karya yang berharga
    rejectLines:
    - Jangan sentuh permukaannya! Kau bisa merusak tekstur dimensionalnya, bodoh!
  - approach: 3
    veryLikeLines:
    - Akhirnyaa~
    likeLines:
    - Kesunyianmu saat membantuku tadi... sangat mendamaikan jiwa seniman.
    neutralLines:
    - Diam saja? Baiklah, selama tidak menggangu ku kerja
    rejectLines:
    - "\u201CKenapa malah diam mematung begitu?! Ucapkan sesuatu, bantu aku!"

  m_Script: {fileID: 11500000, guid: b32718a15d73894478b662a8803d4725, type: 3}
  m_Name: TD_NPC_Bartender
  m_EditorClassIdentifier: 
  npcName: Bartender (Lara)
  maxTurns: 5
  targetResonance: 10
  clueChance: 1
  moodPool:
  - mood: 0
    min: 3
    max: 3
  - mood: 1
    min: 1
    max: 2
  - mood: 2
    min: 0
    max: 0
  - mood: 3
    min: -2
    max: -2
  requiredItems:
  - {fileID: 11400000, guid: 33f817e052510894f9c16dae128740fc, type: 2}
  lockedDialogue: Aku kehabisan pasokan rempah esensial untuk racikan berikutnya.
    Bantu aku ambil dulu.
  rewardItems: []
  introDescription: Aroma pekat rempah eksotis dan minuman kualitas tinggi menguar
    di udara. Sang bartender meramu koktail dengan presisi cepat layaknya seorang
    petarung mengatur strategi, sebuah kontras ketangguhan di tengah kaum borjuis
    yang manja.
  introDialogue: Kerja bagus. Sekarang, apa yang bisa kubantu untuk melancarkan urusanmu?
  winDialogue: Kerjasama yang bersih. Senang berbisnis denganmu di bar ini~
  loseDialogue: Ambil segelas tonik ini, sepertinya syaraf kepalamu sedang butuh
    ditenangkan.
  noClueText: "Ia menyeka gelas kristal dengan kain lap secara berulang-ulang tanpa
    memedulikan tatapanmu.\r"
  hints:
  - approach: 0
    likeLines:
    - Ia menyeringai lebar dengan sorot mata tajam penuh pengakuan.
    rejectLines:
    - Sang bartender mendengus, tidak terkesan dengan gaya matamu.
  - approach: 1
    likeLines:
    - Ia mengangguk mantap sambil menyilangkan tangan di depan dada.
    rejectLines:
    - Ia mengernyit, kebingungan dengan istilah rumit yang kau lontarkan.
  - approach: 2
    likeLines:
    - Ia menyukai kecepatan tanggap dan aksi nyata yang kau tunjukkan.
    rejectLines:
    - "\u201CIa menghela napas panjang melihat caramu bertindak yang gegabah."
  - approach: 3
    likeLines:
    - Senyuman puas terlihat dari muka sang bartender
    rejectLines:
    - Sang bartender menatapmu heran dengan sebelah alis terangkat.
  approachReactions:
  - approach: 0
    veryLikeLines:
    - Mata elang mu sangat di apresiasi di pekerjaan ini~
    likeLines:
    - Kau bisa bertahan di tempat seketat ini dengan mata jeli itu? Tidak buruk.
    neutralLines:
    - Kau jeli, tapi hati-hati, mengamat seperti itu tinggi resiko
    rejectLines:
    - Tatapan menyelidik seperti itu bisa membuat para tamu risi, kawan. Jaga matamu
  - approach: 1
    veryLikeLines:
    - Pelanggan dengan kepala yang terisi? aku suka itu.
    likeLines:
    - "Cukup berbobot. Menarik, menarik juga jalan pikirmu.\u201D"
    neutralLines:
    - oleh juga teorinya. Lanjut kalau ada intinya.
    rejectLines:
    - ...Hah? Istilah apa lagi itu? Sudahlah, tidak penting.
  - approach: 2
    veryLikeLines:
    - Aksi dibanding suara, aku hormat padai orang seperti kamu!
    likeLines:
    - "\u201CHooo, aku suka tipe orang cekatan sepertimu. Gerakan bagus!"
    neutralLines:
    - Gerakan yang lumayan. Masih bisa lebih rapi lagi.
    rejectLines:
    - cukup bagus... tapi akan jauh lebih bagus kalau dipikirkan dulu waktunya.
  - approach: 3
    veryLikeLines:
    - Kamu sedang berbuat baik padaku hanya dengan diam~
    likeLines:
    - Baguslah, setidaknya kau tahu kapan harus diam dan membiarkan orang bekerja.
    neutralLines:
    - Diam saja? yasudah
    rejectLines:
    - Tidak usah pasang muka kaku begitu. Kau bebas bersuara di bar ini, santai saja.

  m_Name: TD_NPC_OfficeBoy
  m_EditorClassIdentifier: 
  npcName: Cleaning (Dean)
  maxTurns: 6
  targetResonance: 5
  clueChance: 0.15
  moodPool:
  - mood: 0
    min: 3
    max: 3
  - mood: 1
    min: 2
    max: 2
  - mood: 2
    min: 0
    max: 0

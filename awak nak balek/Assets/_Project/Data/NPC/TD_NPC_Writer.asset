MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b32718a15d73894478b662a8803d4725, type: 3}
  m_Name: TD_NPC_Writer
  m_EditorClassIdentifier: 
  npcName: Writer (...)
  maxTurns: 5
  targetResonance: 7
  clueChance: 0.55
  moodPool:
  - mood: 0
    min: 3
    max: 3
  - mood: 1
    min: 2
    max: 2
  - mood: 2
    min: 0
    max: 0
  - mood: 3
    min: -2
    max: -2
  requiredItems:
  - {fileID: 11400000, guid: 2654fd81281f7d2428cd2b7318027e6a, type: 2}
  lockedDialogue: ' Siapa kau? Temukan dulu pena perakku yang hilang, baru akan kupikirkan
    apakah kau cukup sepadan dengan waktuku.'
  rewardItems:
  - {fileID: 11400000, guid: 3db96a1ce1ca72f47a5d9f8d6ef1b6ca, type: 2}
  introDescription: "Kata demi kata dilontarkan dengan nada mengalun penuh pretensi\u2014setidaknya
    bagi para kaum intelektual di sekitarnya. Bait-bait puisi yang ia ucapkan sengaja
    dibuat rumit, berat, dan sulit dicerna. "
  introDialogue: "\u201CKau... berhasil menemukan penaku? Baiklah, pengamatan yang
    lumayan. Mungkin kau memang tidak sepenuhnya membosankan. Jadi, apa yang sebenarnya
    kau inginkan dariku?\u201D \r"
  winDialogue: "\u201CLuar biasa! Sungguh menyenangkan bisa berdiskusi dengan sesama
    intelek di ruangan yang penuh orang kaku ini. Terimalah tanda hormatku ini!\u201D "
  loseDialogue: "\u201CCukup! Pergi dari hadapanku, kau hanya membuang-buang waktu
    berhargaku yang bernilai tinggi!\u201D \r\n"
  noClueText: Sang Sastrawan membuang muka, menulis sesuatu di buku catatannya dengan
    gestur sinis.
  hints:
  - approach: 0
    likeLines:
    - He shoves you his magnificant writing for you to stick your eyes
    rejectLines:
    - He takes away his notebook, deeming his works not worth your eyes
  - approach: 1
    likeLines:
    - He speak about some famous poets and expects you to understand
    rejectLines:
    - He is unimpressed with the audience lack of intelect, he fully expects you
      to be the same
  - approach: 2
    likeLines:
    - he challenge you on writing a poet!
    rejectLines:
    - He wanted you to hear his words and not move an inch
  - approach: 3
    likeLines:
    - when you talk, he read his poet louder
    rejectLines:
    - the lack of feedback sours him
  approachReactions:
  - approach: 0
    veryLikeLines:
    - Akhirnya! Seseorang yang mampu menangkap nuansa batin di balik setiap jeda
      napasku! Kau punya jiwa yang tajam, kawan!
    likeLines:
    - Gaya bahasa puisiku... indah dan berlapis kan? Kau pasti merasakannya.
    neutralLines:
    - Pengamatan yang biasa saja. Belum menyentuh kedalaman yang kumaksud.
    rejectLines:
    - ...Ada apa? Kenapa dari tadi kau mengamati gerak-gerikku terus?
  - approach: 1
    veryLikeLines:
    - "Brilian! Referensimu tepat sasaran\u2014akhirnya ada yang bicara pada level
      yang setara denganku"
    likeLines:
    - Jadi, ternyata bukan cuma aku satu-satunya orang pintar di gedung busuk ini
    neutralLines:
    - Cukup tahu, rupanya. Tapi kutipan saja belum cukup.
    rejectLines:
    - Kau pikir kau siapa, hah? Apa kau benar-benar paham substansi dari apa yang
      kau debatkan?
  - approach: 2
    veryLikeLines:
    - Luar biasa! Gerakanmu punya ritme yang nyaris... puitis! Aku menyukai kejutan
      semacam itu!
    likeLines:
    - Kuhargai kenyataan bahwa kau tidak menggebrak meja atau bicara terus-menerus.
    neutralLines:
    - Cukup menarik, meski sedikit terlalu ramai untuk seleraku.
    rejectLines:
    - Gerakan apa itu tadi? Jangan merusak estetika ruanganku!
  - approach: 3
    veryLikeLines:
    - Sempurna... keheningan yang sarat makna! Kadang yang tidak terucapkan justru
      paling menggema!
    likeLines:
    - Hooo... Menarik juga caramu mendengarkan dalam diam.
    neutralLines:
    - "\u201CHening lagi. Entah ini kedalaman, atau sekadar kehabisan kata."
    rejectLines:
    - Mau coba-coba mempermainkanku dengan bungkam, hah? Pergi sana!

MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b32718a15d73894478b662a8803d4725, type: 3}
  m_Name: TD_NPC_Writer
  m_EditorClassIdentifier: 
  npcName: Writer (Diego)
  maxTurns: 5
  targetResonance: 7
  clueChance: 0.45
  moodPool:
  - mood: 0
    min: 3
    max: 3
  - mood: 1
    min: 2
    max: 2
  - mood: 2
    min: 0
    max: 0
  - mood: 3
    min: -2
    max: -2
  requiredItems:
  - {fileID: 11400000, guid: 2654fd81281f7d2428cd2b7318027e6a, type: 2}
  lockedDialogue: Dan siapa kamu? Hmm... carikan aku pulpenku, nanti kita lihat saja
    selanjutnya apa
  rewardItems:
  - {fileID: 11400000, guid: 3db96a1ce1ca72f47a5d9f8d6ef1b6ca, type: 2}
  introDescription: "Kata-kata dalam puisi-puisinya sarat dengan makna yang mendalam,
    setidaknya bagi para \u201Cintelektual\u201D di sekelilingnya. Hal itu sengaja
    dibuat agar terdengar lebih indah daripada yang sebenarnya."
  introDialogue: Kamu benar-benar menemukan pulpenku? Eh, lumayanlah. Ayo kita lihat
    apa yang kamu bawa yang nilainya lebih berharga daripada waktuku
  winDialogue: Luar biasa! Itulah yang kuharapkan dari orang secerdas dirimu! Nah,
    ini surat rekomendasi yang membuktikan bahwa kamu bukan sekadar gelandangan biasa
  loseDialogue: Cukup! Pergi dari hadapanku! Kau benar-benar membuang-buang waktuku
  noClueText: Penyair itu bersikap seolah-olah dirinya sangat hebat dan angkuh, sehingga
    kamu tidak bisa menganalisis tindakannya tanpa merasa jijik
  hints:
  - approach: 0
    likeLines:
    - Dia menyodorkan tulisan indahnya kepadamu agar kamu bisa memandangnya
    rejectLines:
    - Dia mengambil buku catatannya, karena menganggap matamu tidak pantas untuk
      dimanjakan oleh puisi buatan nya
  - approach: 1
    likeLines:
    - Dia berbicara tentang beberapa penyair terkenal dan berharap kamu mengerti
    rejectLines:
    - Dia tidak terkesan dengan kurangnya kecerdasan penonton, dia yakin kamu  juga
      sama saja
  - approach: 2
    likeLines:
    - Dia menantangmu untuk menjadi peraga latar puisinya
    rejectLines:
    - Dia ingin kamu mendengarkan kata-katanya dan tidak bergerak sedikit pun
  - approach: 3
    likeLines:
    - Saat kamu berbicara, dia membacakan puisinya dengan suara lebih keras
    rejectLines:
    - Kurangnya umpan balik membuatnya kesal
  approachReactions:
  - approach: 0
    veryLikeLines:
    - Akhirnya ada yang sadar!
    likeLines:
    - Puisi-puisiku keren, ya?
    neutralLines:
    - Kamu baru saja mengatakan hal yang sudah jelas, tapi aku biarkan saja, tidak
      semua orang desa tahu hal itu
    rejectLines:
    - Apa? Ada yang aneh dengan aku?
  - approach: 1
    veryLikeLines:
    - Referensi yang luar biasa! Senang sekali melihat ada orang cerdas lainnya di
      sini!
    likeLines:
    - Ternyata aku bukan satu-satunya yang cukup berbakat di sini
    neutralLines:
    - Cukup dasar.
    rejectLines:
    - Pelajari dulu apa yang kamu bicarakan sebelum bicara sembarangan ke aku
  - approach: 2
    veryLikeLines:
    - Ya! Begitu! Kamu membuat puisi-puisiku terasa lebih hidup!
    likeLines:
    - Itu arah yang benar!
    neutralLines:
    - Kamu terlalu banyak bergerak, coba tenang sebentar, ya?
    rejectLines:
    - Dan menurutmu, apa yang sedang kamu lakukan?
  - approach: 3
    veryLikeLines:
    - Dengarkan dan pelajari, dengarkan dan pelajari
    likeLines:
    - Bagus, puisi-puisiku membuatmu kehabisan kata-kata
    neutralLines:
    - Sudah kuduga, kamu bahkan nggak bisa ngikutin!
    rejectLines:
    - Jadi, kamu sudah bersusah payah seperti itu hanya untuk kemudian menghilang
      begitu saja dariku?!

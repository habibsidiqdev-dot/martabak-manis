%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b32718a15d73894478b662a8803d4725, type: 3}
  m_Name: TD_NPC_Artist
  m_EditorClassIdentifier: 
  npcName: Artist (Elise)
  maxTurns: 4
  targetResonance: 8
  clueChance: 0.35
  moodPool:
  - mood: 0
    min: 3
    max: 3
  - mood: 1
    min: 2
    max: 2
  - mood: 2
    min: 0
    max: 0
  - mood: 3
    min: -2
    max: -2
  requiredItems:
  - {fileID: 11400000, guid: c544d895c91904245884e8a3f9b28aa6, type: 2}
  lockedDialogue: Lukisanku hancur! Tolong, kamu harus cariin aku sesuatu buat mengencerkan
    cat yang rusak ini
  rewardItems:
  - {fileID: 11400000, guid: 33f817e052510894f9c16dae128740fc, type: 2}
  introDescription: Di dekat perapian,  seorang pelukis tampak  berantakan; cat berserakan
    di mana-mana, mulai dari lantai hingga wajahnya. Untungnya, keadaan sulit yang
    dialaminya saat ini tidak mengurangi motivasinya untuk mewujudkan karya agungnya
  introDialogue: Itu dia! Ya, ya, ya, terima kasih! Kamu adalah penyelamat gerakan
    seni modern! Aku berhutang budi padamu!
  winDialogue: Kamu hebat! Kau Tahu? Kamu bahkan bisa jadi murid jeniusku! Nah, ambil
    surat ini untuk meyakinkan si bapak tua di lobi agar mengizinkanmu keluar dan
    mengembangkan bakatmu itu!
  loseDialogue: Konsentrasiku hancur sekarang! Pergi saja dan biarkan aku berpikir
    sebentar. Terima kasih, tapi nggak ada gunanya!
  noClueText: "Dia begitu fokus sehingga tidak ada tanda-tanda yang mencolok yang
    terlihat darinya\r"
  hints:
  - approach: 0
    likeLines:
    - Dengan kehadiranmu di sini, sapuan kuasnya jadi lebih...mencolok
    rejectLines:
    - Goresan kuasnya semakin lemah karena ada yang menatapnya
  - approach: 1
    likeLines:
    - Dia bertanya kepadamu apakah kamu tahu apa yang menjadi inspirasi gaya seninya
    rejectLines:
    - Dia mencurahkan rasa frustrasinya kepadamu mengenai orang-orang di sini yang
      membicarakan seni seolah-olah mereka bisa melukis
  - approach: 2
    likeLines:
    - Dia memberimu sebuah kanvas kecil agar kamu juga bisa melakukan sesuatu
    rejectLines:
    - Dia melirik lukisannya, lalu meminta kamu untuk tidak menyentuhnya
  - approach: 3
    likeLines:
    - Dia tampak sedang berpikir dan langsung menggagalkan setiap upaya untuk berbicara
      atas namamu
    rejectLines:
    - Dia kesulitan berkonsentrasi tanpa berbicara dengan siapa pun
  approachReactions:
  - approach: 0
    veryLikeLines:
    - Luar biasa! Aku bahkan tidak bermaksud agar orang lain bisa dengan mudah melihatnya!
    likeLines:
    - Kamu lihat itu? Benarkah? Kamu bersumpah?
    neutralLines:
    - Itu kan... cukup jelas?
    rejectLines:
    - Jangan intip! Karya ini belum selesai!
  - approach: 1
    veryLikeLines:
    - Dengan pengetahuan itu, kamu mungkin adalah sseorang ahli yang terlahir kembali!
    likeLines:
    - Wah, kamu benar-benar tahu banyak! Padahal aku sendiri baru tahu soal itu belum
      lama ini
    neutralLines:
    - Eh, aku sih udah tahu itu, tapi, tidak semua orang tahu
    rejectLines:
    - 'Kamu tidak berpikir aku sudah tahu itu? Ayolah, aku bukan pemula '
  - approach: 2
    veryLikeLines:
    - Benar sekali! Seni bukan hanya soal kecerdasan, tapi juga soal refleks.
    likeLines:
    - Refleks yang bagus!
    neutralLines:
    - Intuisimu bagus, tapi hati-hati! Kamu bisa merusak hasil kerjaku
    rejectLines:
    - Jangan, jangan, jangan sentuh itu! Kamu akan merusak lukisannya!
  - approach: 3
    veryLikeLines:
    - Terima kasih, susah untuk fokus di sini,  sepertinya  aku salah pilih tempat
      untuk melukis.
    likeLines:
    - 'Banyak sekali orang yang ngobrol di sini, bagus  kamu tidak ikut-ikutan  '
    neutralLines:
    - Ada apa? Kehabisan inspirasi?
    rejectLines:
    - Hei, kalau kamu tidak mau bantu, setidaknya kasih aku masukan!
